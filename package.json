{
  "name": "dstamp-mvp",
  "version": "1.1.0",
  "description": "Site de pedidos (varejo) + painel operacional da D-Stamp — estampa total, localizada via WhatsApp, brindes e revenda",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "DSTAMP_DEV=1 node server.js",
