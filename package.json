    "test": "node test/price-test.js",
    "test:ui": "node test/dom-test.js",
    "backup": "node tools/backup.js",
    "restore": "node tools/backup.js restore"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
